#!/bin/sh
# The full check: the one entry point CI and the pre-push hook both run, so the two cannot drift.
# Keep it free of CI-only setup (checkout, caching). Order: cheapest first, fail fast.
set -eu
cd "$(dirname "$0")/.."

echo "==> ruff check";          uv run ruff check .
echo "==> ruff format --check"; uv run ruff format --check .
echo "==> mypy (strict)";       uv run mypy
echo "==> unit tests: 100% branch coverage of core"
COVERAGE_FILE=.coverage-unit uv run coverage run -m pytest -q tests/unit
COVERAGE_FILE=.coverage-unit uv run coverage report --include='*/core/*' --fail-under=100
echo "==> all tests: 95% branch coverage overall"
uv run coverage run -m pytest -q
uv run coverage report --fail-under=95 --skip-covered
echo "==> openspec validate";   npx --no-install openspec validate --all --strict --no-interactive
echo "==> full check passed"
